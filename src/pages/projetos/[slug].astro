---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/rapido.css';
import { site } from '../../content/site';
import { CabecalhoProjeto } from '../../components/comum/CabecalhoProjeto';
import { GaleriaProjeto } from '../../components/comum/GaleriaProjeto';
import { carregarProjetos } from '../../lib/projetos';

export async function getStaticPaths() {
  const [entradas, projetos] = await Promise.all([getCollection('projetos'), carregarProjetos()]);
  return entradas.map((entrada) => ({
    params: { slug: entrada.id },
    props: { entrada, projeto: projetos.find((p) => p.slug === entrada.id)! },
  }));
}

const { entrada, projeto } = Astro.props;
const { Content } = await render(entrada);
---
<Base titulo={`${projeto.titulo} · ${site.nome}`} descricao={projeto.resumo} caminho={`/projetos/${projeto.slug}/`}>
  <nav class="p-barra" aria-label="Navegação">
    <a href={`/#/projetos/${projeto.slug}`}>⌂ ABRIR NO JGBR11 OS</a>
    <a href="/rapido/">⚡ MODO RÁPIDO</a>
  </nav>
  <main class="p-conteudo">
    <CabecalhoProjeto projeto={projeto} nivel="h1" />
    <GaleriaProjeto galeria={projeto.galeria} />
    <article class="prosa"><Content /></article>
  </main>
  <footer class="r-rodape"><a href="/rapido/#t-projetos">← todos os projetos</a></footer>
</Base>
